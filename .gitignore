# Build outputs
McpRimDebug/bin/
McpRimDebug/obj/
Source/**/bin/
Source/**/obj/

# .NET runtime
# 注意：runtime/dotnet/ 虽在此被忽略，但发布仓库里**必须存在**（没有对应 zip，无法首启重建），
# 因此提交时用 `git add -f runtime/dotnet` 强制加入（.gitignore 只影响未跟踪文件）。
runtime/dotnet/

# Portable node/bun runtimes (large, environment-specific)
runtime/bun/
runtime/node/

# Tool directories
.commandcode/
.superpowers/

# MCP
MCP/node_modules/
MCP/node_modules.zip
MCP/logs/
MCP/stream-capture/out/

# Git worktrees（本地并行开发用，不入库）
.worktrees/

# MCP runtime session file (regenerated each game launch, contains session token)
MCP/ports.json

# UE_Data logs
UE_Data/sinai-dev-UnityExplorer/logs/

# Release builds
Source/UE-4.9.0-official/UnityExplorer-4.9.0/Release/


# Third-party source bundled DLLs
Source/UniverseLib-official/UniverseLib-1.5.1/lib/
Source/UE-4.9.0-official/UnityExplorer-4.9.0/lib/

# 构建期 vendor 的 0Harmony 副本（brrainz.harmony Current 槽位 v2.4.1）。
# 必须入库：三个 csproj 都靠它编译，且 Mono 精确版本绑定要求它与运行面完全一致。
# 上面的 lib/ 忽略规则会把本文件一并吞掉 —— 注意 git 规则是「最后匹配者胜」，
# 故放行规则必须排在忽略规则之后，且要先放行目录本身、再重新忽略其余文件。
!Source/UE-4.9.0-official/UnityExplorer-4.9.0/lib/
Source/UE-4.9.0-official/UnityExplorer-4.9.0/lib/*
!Source/UE-4.9.0-official/UnityExplorer-4.9.0/lib/0Harmony-brrainz-*.dll

# ---- 运行期与一次性产物不入库 ----
/InternalTrace*.log
/_poc_roslyn/*.dll
/_poc_roslyn/*.exe
/_poc_roslyn/*.pdb
/temp/
/runtime/McpRimDebug/*.pdb
