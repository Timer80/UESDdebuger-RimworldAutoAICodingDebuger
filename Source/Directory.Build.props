<Project>
  <PropertyGroup>
    <!-- P1-BD-1：路径参量化。覆写优先级：命令行 -p: > 环境变量(大写) > 常量默认值 -->

    <!-- 游戏根：优先环境变量 RIMWORLD_GAME_DIR，否则默认本机 Steam 路径 -->
    <RimWorldGameDir Condition="'$(RimWorldGameDir)'=='' and '$(RIMWORLD_GAME_DIR)'!=''">$(RIMWORLD_GAME_DIR)</RimWorldGameDir>
    <RimWorldGameDir Condition="'$(RimWorldGameDir)'==''">C:\SteamLibrary\steamapps\common\RimWorld</RimWorldGameDir>
    <RimWorldManagedDir>$(RimWorldGameDir)\RimWorldWin64_Data\Managed</RimWorldManagedDir>

    <!-- 模组根：优先环境变量 UESD_MOD_ROOT，否则取本文件父目录的父目录（克隆到哪都对） -->
    <UESDModRoot Condition="'$(UESDModRoot)'=='' and '$(UESD_MOD_ROOT)'!=''">$(UESD_MOD_ROOT)</UESDModRoot>
    <UESDModRoot Condition="'$(UESDModRoot)'==''">$(MSBuildThisFileDirectory)..</UESDModRoot>

    <AssetsOutDir>$(UESDModRoot)\Assemblies</AssetsOutDir>
    <!-- UE 编译引用目录（本模组 Assemblies 下重编译产物）与 AssetsOutDir 同值、语义不同 -->
    <UEProjectDir>$(UESDModRoot)\Assemblies</UEProjectDir>
    <HarmonyRefDir>$(UESDModRoot)\Source\UELoader\lib</HarmonyRefDir>
  </PropertyGroup>

  <!-- 前置守卫：引用缺失时给出明确错误，避免 MSB3245 模糊失败 -->
  <Target Name="GuardRefs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')"
           Text="RimWorld 未找到：$(RimWorldManagedDir)。请设 -p:RimWorldGameDir=&lt;游戏根&gt; 或环境变量 RIMWORLD_GAME_DIR。" />
    <Error Condition="!Exists('$(HarmonyRefDir)\0Harmony.dll')"
           Text="编译用 0Harmony 副本缺失：$(HarmonyRefDir)\0Harmony.dll（应 vendor brrainz v2.3.3，勿用 UE 自带 v2.5.2）。" />
  </Target>
</Project>
