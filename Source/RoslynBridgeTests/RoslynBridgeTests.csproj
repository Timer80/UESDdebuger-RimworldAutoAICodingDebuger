<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>RoslynBridgeTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 任务 1 只 link 加载器；任务 2 加 ReferenceSet；任务 4/5 加 PolyfillSource/DiagnosticFormatter/RoslynCompiler；任务 6 加 ReplSession；任务 7 加 IScriptEvaluator/RoslynScriptEvaluator -->
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\RoslynAssemblyLoader.cs" Link="RoslynAssemblyLoader.cs" />
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\ReferenceSet.cs" Link="ReferenceSet.cs" />
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\DefaultUsings.cs" Link="DefaultUsings.cs" />
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\PolyfillSource.cs" Link="PolyfillSource.cs" />
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\DiagnosticFormatter.cs" Link="DiagnosticFormatter.cs" />
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\RoslynCompiler.cs" Link="RoslynCompiler.cs" />
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\ReplSession.cs" Link="ReplSession.cs" />
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\CSConsole\IScriptEvaluator.cs" Link="IScriptEvaluator.cs" />
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\RoslynScriptEvaluator.cs" Link="RoslynScriptEvaluator.cs" />
    <!-- 任务 9：补全（语义模型 + 命名空间元数据）。KeywordLexer 不可 link（基类 Lexer → LexerBuilder →
         UE/Unity 依赖），其关键字表用**源码文本断言**覆盖，理由见报告 §22。 -->
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\RoslynCompletion.cs" Link="RoslynCompletion.cs" />
    <!-- 根因清扫轮（§17，追加 E）：纯决策逻辑（无 Unity/UE/Roslyn/mcs 依赖）链接进来做真值表离线断言 -->
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\EvaluatorSelector.cs" Link="EvaluatorSelector.cs" />
    <!-- 任务 10：动态 Harmony 补丁的"包装 + 产物里取回"纯逻辑（无 Unity/UE/Roslyn/mcs 依赖）⇒ 可离线断言
         "包装 → 提交编译 → 产物里定位嵌套补丁类型 → 取隐式 private 的补丁方法 → Harmony 挂载生效"。 -->
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\DynamicPatch.cs" Link="DynamicPatch.cs" />
    <!-- R2（§18）：引用集"档案 + 组装"纯逻辑（无 Verse/Unity/ExplorerCore 依赖）⇒ 可离线断言 -->
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\ReferenceProfile.cs" Link="ReferenceProfile.cs" />
    <!-- 任务 13：引用自愈（纯逻辑两件：诊断文本解析 + 程序集/命名空间 → dll 解析） -->
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\MissingReferenceParser.cs" Link="MissingReferenceParser.cs" />
    <Compile Include="..\UE-4.9.0-official\UnityExplorer-4.9.0\src\RoslynBridge\ReferenceHealer.cs" Link="ReferenceHealer.cs" />
    <!-- R1（§18）：mcs 侧语义 harness 需要真实的 Mono.CSharp（net35 mcs.dll，本仓库 vendor 副本） -->
    <Reference Include="mcs"><HintPath>..\UE-4.9.0-official\UnityExplorer-4.9.0\lib\net35\mcs.dll</HintPath></Reference>
    <!-- 任务 10：Harmony 链路端到端离线断言（补丁真的挂上去、真的生效）。版本与 UE csproj **同版本**
         ——否则测的不是要被部署的那套 Harmony 语义。 -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>..\UE-4.9.0-official\UnityExplorer-4.9.0\lib\roslyn\Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>..\UE-4.9.0-official\UnityExplorer-4.9.0\lib\roslyn\Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <!-- 任务 5：RoslynCompiler.cs 触碰 ImmutableArray<Diagnostic>（CS0012 → 必须引用 Immutable）；
         以下传递依赖 RAR 不会自动复制进输出，显式引用以进 bin（Roslyn 运行时直接按文件名加载）。 -->
    <Reference Include="System.Collections.Immutable"><HintPath>..\UE-4.9.0-official\UnityExplorer-4.9.0\lib\roslyn\System.Collections.Immutable.dll</HintPath></Reference>
    <Reference Include="System.Reflection.Metadata"><HintPath>..\UE-4.9.0-official\UnityExplorer-4.9.0\lib\roslyn\System.Reflection.Metadata.dll</HintPath></Reference>
    <Reference Include="System.Memory"><HintPath>..\UE-4.9.0-official\UnityExplorer-4.9.0\lib\roslyn\System.Memory.dll</HintPath></Reference>
    <Reference Include="System.Threading.Tasks.Extensions"><HintPath>..\UE-4.9.0-official\UnityExplorer-4.9.0\lib\roslyn\System.Threading.Tasks.Extensions.dll</HintPath></Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe"><HintPath>..\UE-4.9.0-official\UnityExplorer-4.9.0\lib\roslyn\System.Runtime.CompilerServices.Unsafe.dll</HintPath></Reference>
  </ItemGroup>
</Project>
