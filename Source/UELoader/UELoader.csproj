<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>UELoader</RootNamespace>
    <AssemblyName>UELoader</AssemblyName>
    <Version>0.9.0.1</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 首启解压 bun 运行时（UnzipRuntime.cs）需要的 BCL 程序集；运行时由游戏 Mono 提供 -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!-- RimWorld 游戏程序集（编译引用，不复制）。
         路径已参量化到 $(RimWorldManagedDir)（Source/Directory.Build.props）。
         历史迁移备注：目标游戏曾指向 F:\RimWorld3（1.6.9438）改指
         C:\SteamLibrary\steamapps\common\RimWorld（1.6.9676，1.6.9438 的
         Assembly-CSharp.dll 哈希与其不一致）。 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 坐标光标 shader 走 AssetBundle.LoadFromFile 读取（UECoordCursorShader.cs）；
         UnityEngine.AssetBundle 被 type-forward 到 UnityEngine.AssetBundleModule，需显式引用。 -->
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UE 公共 API 面涉及的 UnityEngine 模块（保险引用，避免元数据传递解析失败） -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- P1-BD-1：0Harmony 仅编译引用（Private=false，不复制到 bin/Assemblies）。
         运行期真身由 brrainz.harmony 的 Lib.Harmony 提供；vendor 副本版本必须恒等于 brrainz 运行面版本。
         升级 brrainz 时须同步替换 Source/UELoader/lib/0Harmony.dll。 -->
    <!-- 0Harmony 2.3.3（brrainz.harmony / Lib.Harmony，与重编译 UE 编译面一致）。
         编译副本位于 $(HarmonyRefDir)（Source/UELoader/lib）；运行时由 brrainz.harmony 模组提供；
         UESDdebuger/Assemblies 不再携带 0Harmony。 -->
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyRefDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 重编译的 UE 二进制（$(UEProjectDir)，即 UESDdebuger/Assemblies，编译引用、不复制到输出） -->
    <Reference Include="UnityExplorer.STANDALONE.Mono">
      <HintPath>$(UEProjectDir)\UnityExplorer.STANDALONE.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniverseLib.Mono">
      <HintPath>$(UEProjectDir)\UniverseLib.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 热重载桥的字段校验已改为纯反射（读内存中的新旧程序集 IL + 类型字段布局），
         不再需要 Mono.Cecil 编译引用（2026-09-19：原实现读磁盘 DLL，而磁盘已被新构建覆盖 → 误判）。 -->
  </ItemGroup>

  <!-- 构建后把 UELoader.dll 部署到 $(AssetsOutDir)（仅本产物，避免覆盖官方 UE DLL） -->
  <Target Name="DeployToAssemblies" AfterTargets="Build">
    <MakeDir Directories="$(AssetsOutDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AssetsOutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(AssetsOutDir)" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>

</Project>
